{
  "expo": {
    "name": "Fenced",
    "slug": "fenced",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "fenced",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.fenced.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Authenticate with Face ID"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1F3D30"
      },
      "package": "com.fenced.app"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "@clerk/expo"
    ]
  }
}
