{
  "name": "@fenced/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./router": "./src/trpc/routers/index.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^1.2.22",
    "@ai-sdk/openai": "^1.3.0",
    "@clerk/backend": "^3.14.0",
    "@fenced/ai": "workspace:*",
    "@fenced/core": "workspace:*",
    "@fenced/ical": "workspace:*",
    "@fenced/policy": "workspace:*",
    "@hono/node-server": "^1.14.0",
    "@trpc/server": "^11.0.0",
    "ai": "^4.3.0",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.44.0",
    "hono": "^4.7.0",
    "postgres": "^3.4.7",
    "superjson": "^2.2.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.0",
    "typescript": "~5.8.0"
  },
  "scripts": {
    "test": "tsx --test \"src/**/__tests__/*.test.ts\"",
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --dts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:migrate-v3": "node scripts/migrate-v3.mjs",
    "db:studio": "drizzle-kit studio"
  }
}
