# API + Supabase Postgres (never commit real secrets)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require
PORT=3001

# Optional Supabase client keys (mobile/web)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Clerk — mobile (Expo)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Clerk — API JWT verification
CLERK_SECRET_KEY=
CLERK_JWT_KEY=

# Mobile
EXPO_PUBLIC_API_URL=http://localhost:3001

# Cron
CRON_SECRET=

# Generative AI (adult-only; server-side only — never put keys in mobile).
# Kill switch: AI_ENABLED=false. Put these in apps/api/.env (API cwd).
AI_ENABLED=false
AI_PROVIDER=google
# Gemini (Google AI Studio): https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Alias also accepted:
# GEMINI_API_KEY=
AI_MODEL=gemini-2.5-flash
# Optional OpenAI / Vercel AI Gateway instead of Gemini
OPENAI_API_KEY=
AI_GATEWAY_API_KEY=
AI_GATEWAY_URL=
