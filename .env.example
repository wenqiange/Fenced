# API + Supabase Postgres (never commit real secrets)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require
PORT=3001

# Optional Supabase client keys (mobile/web)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# API token verification
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=


# Mobile
EXPO_PUBLIC_API_URL=http://localhost:3001

# Cron
CRON_SECRET=

# Generative AI (adult-only; server-side only — never put keys in mobile).
# Kill switch: AI_ENABLED=false. Put these in apps/api/.env (API cwd).
AI_ENABLED=false
AI_PROVIDER=google
# Gemini (Google AI Studio): https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Alias also accepted:
# GEMINI_API_KEY=
AI_MODEL=gemini-2.5-flash
# Optional OpenAI / Vercel AI Gateway instead of Gemini
OPENAI_API_KEY=
AI_GATEWAY_API_KEY=
AI_GATEWAY_URL=

# ── Calendar sync & export ──────────────────────────────────────────────────
# Public base URL of the API. Used to build the OAuth redirect URI and the
# subscribable ICS feed URL, so it must be reachable by Google and by calendar
# clients (i.e. not localhost in production).
API_PUBLIC_URL=http://localhost:3001

# Google Cloud OAuth client (type: Web application).
# Console → APIs & Services → Credentials → Create OAuth client ID.
# Enable the Google Calendar API for the project first.
# Add this exact redirect URI to the client:
#   $API_PUBLIC_URL/oauth/google/calendar/callback
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Only needed if the redirect URI differs from the default above.
GOOGLE_CALENDAR_REDIRECT_URI=

# Encrypts provider OAuth tokens at rest (AES-256-GCM). REQUIRED to connect a
# calendar — the server refuses to store tokens without it. 32 bytes:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CALENDAR_TOKEN_KEY=

# Signs the OAuth `state` parameter (CSRF protection for the redirect round
# trip). Falls back to GOOGLE_CALENDAR_CLIENT_SECRET when unset.
CALENDAR_OAUTH_STATE_SECRET=

# Where the OAuth callback redirects when it is done. Must match the returnUrl
# the mobile app passes to openAuthSessionAsync. For Expo Go, set this to the
# value `npx expo start` prints, e.g. exp://192.168.1.10:8081/--/calendar-connected
APP_OAUTH_RETURN_URL=fenced://calendar-connected
