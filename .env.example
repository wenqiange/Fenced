# API + Supabase Postgres (never commit real secrets)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require
PORT=3001

# Optional Supabase client keys (mobile/web)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Clerk — mobile (Expo)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Clerk — API JWT verification
CLERK_SECRET_KEY=
CLERK_JWT_KEY=

# Mobile
EXPO_PUBLIC_API_URL=http://localhost:3001

# Cron
CRON_SECRET=
